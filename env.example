# ===== KOTAK NEO =====
KOTAK_CONSUMER_KEY=
KOTAK_MOBILE_NUMBER=
KOTAK_UCC=
KOTAK_MPIN=
KOTAK_ENVIRONMENT=prod

# ===== TELEGRAM =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-secret
PUBLIC_URL=https://king-bro-4pn0.onrender.com

# ===== DURABLE PRIVATE GIST =====
# Fine-grained GitHub token: Account permissions -> Gists -> Read and write
GITHUB_TOKEN=
STATE_GIST_ID=
STATE_GIST_FILENAME=kingbro_original_state.json

# Leave blank on the SAME Render service. Only for a one-time migration
# from a different old service URL.
BOOTSTRAP_URL=

# ===== RELIABILITY =====
KINGBRO_KEEPALIVE_ENABLED=true
KINGBRO_KEEPALIVE_INTERVAL_SECONDS=480
# Optional override. Blank uses PUBLIC_URL/health.
KINGBRO_KEEPALIVE_URL=
KINGBRO_SUPERVISOR_ENABLED=true
KINGBRO_FEED_STALE_SECONDS=120
KINGBRO_AUTO_STATE_SAVE_SECONDS=300

# kotakneoapi 3.0.6 historical_data() gap-fill (best effort; Gist is primary)
KINGBRO_HISTORICAL_BACKFILL=true
KINGBRO_HISTORICAL_LOOKBACK_DAYS=5

PYTHON_VERSION=3.12.10
