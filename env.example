# kingbro_original_state.json
# Initial content can be: {}
GITHUB_TOKEN=
STATE_GIST_ID=
STATE_GIST_FILENAME=kingbro_original_state.json

# ===== Optional one-time migration source =====
# Leave blank when replacing the same old Render service URL.
BOOTSTRAP_URL=
